FROM python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
WORKDIR /opt/ml
COPY requirements-init.txt tools/check_lock.py ./
# --no-deps prevents pip from introducing any unpinned transitive dependency.
RUN python -m pip install --no-cache-dir --no-deps -r requirements-init.txt \
    && python check_lock.py requirements-init.txt && python -m pip check \
    && groupadd --gid 10001 inference \
    && useradd --uid 10001 --gid 10001 --no-create-home inference \
    && mkdir -p /models && chown 10001:10001 /models
COPY app/download_model.py ./app/download_model.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp \
    HF_HOME=/tmp/huggingface HF_HUB_DISABLE_PROGRESS_BARS=1 \
    HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
USER 10001:10001
ENTRYPOINT ["python", "/opt/ml/app/download_model.py"]
